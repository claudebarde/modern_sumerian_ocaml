{
  "name": "modern_sumerian_ocaml",
  "version": "0.0.1",
  "description": "The Modern Sumerian Website",
  "scripts": {
    "build": "vite build",
    "build:full": "npm run precompile && npm run build",
    "hooks:install": "git config core.hooksPath .githooks",
    "precompile": "dune build @modern_sumerian_ocaml && rsync -a --delete _build/default/output/ generated/",
    "dev": "dune build && concurrently 'npm:vite-dev' 'npm:dune-watch'",
    "dune-watch": "dune build -w",
    "serve": "dune build && vite preview",
    "vite-dev": "vite _build/default"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/material": "^9.2.0",
    "@supabase/supabase-js": "^2.110.7",
    "@tabler/icons-react": "^3.45.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-select": "^5.10.2",
    "sass": "^1.101.0"
  },
  "devDependencies": {
    "@rollup/plugin-node-resolve": "^16.0.3",
    "concurrently": "^10.0.3",
    "vite": "^8.1.5",
    "vite-plugin-melange": "^3.11.0"
  }
}
